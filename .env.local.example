# Ready-to-use config for a LOCAL Supabase stack (`npx supabase start`).
# Copy to `.env.local` to get running immediately:  cp .env.local.example .env.local
#
# The key below is the standard local development key that ships with the
# Supabase CLI. It is public, identical on every machine, and useless against
# a hosted project — that is why it is safe to commit.
#
# Newer CLI versions print a `sb_publishable_...` key instead of this JWT.
# Both are accepted locally; if you hit auth errors, run `npx supabase status`
# and paste whichever key it shows.
#
# The URL uses `localhost` rather than `127.0.0.1` deliberately: the dev server
# is on localhost, and mixing the two makes Firefox treat API calls as
# cross-origin.

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

VITE_APP_NAME=SuperCove
VITE_CURRENCY=USD
VITE_AUTH_PROVIDERS=password
