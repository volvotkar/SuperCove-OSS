# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill it in. Nothing here is secret:
# everything with a VITE_ prefix is compiled into the browser bundle and is
# visible to anyone who opens devtools. Never put a service-role key,
# a Google client secret, or a VAPID *private* key in this file.
#
# Full reference: docs/configuration.md
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# From your Supabase project: Settings -> API.
# For local development, `npx supabase start` prints both values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# --- Branding (optional) --------------------------------------------------
VITE_APP_NAME=SuperCove
VITE_APP_TAGLINE=Personal ops

# Shown in the "not on the allowlist" error, so people can find the setup docs.
VITE_PROJECT_URL=https://github.com/volvotkar/SuperCove-OSS


# --- Money and dates (optional) -------------------------------------------
# ISO 4217 currency code: USD, EUR, GBP, INR, JPY, AUD...
VITE_CURRENCY=USD
# BCP 47 locale for number and date formatting. Leave blank to follow the browser.
VITE_LOCALE=


# --- Sign-in (optional) ---------------------------------------------------
# Comma-separated: "password", "google", or "google,password".
#
# password : email + password. Works immediately, no extra setup.
# google   : nicer day to day (no password re-entry, and it's the same account
#            the Calendar integration uses), but needs a Google OAuth client
#            configured in Supabase -> Authentication -> Providers.
#
# Either way the allowlist still applies: an address that isn't in
# public.allowed_emails cannot create an account.
VITE_AUTH_PROVIDERS=password


# --- Google Calendar (optional) -------------------------------------------
# Requires VITE_AUTH_PROVIDERS to include "google", plus GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET set as edge function secrets (NOT here).
# See docs/google-calendar.md. Off by default: signing in with Google does not
# imply granting calendar access.
VITE_GOOGLE_CALENDAR=false


# --- Push reminders (optional) --------------------------------------------
# The PUBLIC half of a VAPID keypair. The private half belongs in your edge
# function secrets and must never appear here.
# Leave blank to hide the reminders feature entirely.
# See docs/push-notifications.md.
VITE_VAPID_PUBLIC_KEY=
